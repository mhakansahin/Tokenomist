{
  "name": "tokenomist",
  "displayName": "Tokenomist",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "mhakansahin61",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhakansahin/Tokenomist.git"
  },
  "bugs": {
    "url": "https://github.com/mhakansahin/Tokenomist/issues"
  },
  "homepage": "https://github.com/mhakansahin/Tokenomist#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.specify/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tokenomist.analyzeSpec",
        "title": "%command.analyzeSpec%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.showRecommendation",
        "title": "%command.showRecommendation%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.finishSpec",
        "title": "%command.finishSpec%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.showSummaries",
        "title": "%command.showSummaries%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.openSetup",
        "title": "%command.openSetup%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.showStatusDetails",
        "title": "%command.showStatusDetails%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.cleanClaudeSettings",
        "title": "%command.cleanClaudeSettings%",
        "category": "Tokenomist"
      },
      {
        "command": "tokenomist.changeModel",
        "title": "%command.changeModel%",
        "category": "Tokenomist"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "tokenomist.showStatusDetails",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Tokenomist",
      "properties": {
        "tokenomist.automation": {
          "type": "string",
          "enum": [
            "auto",
            "ask"
          ],
          "default": "auto",
          "scope": "window",
          "enumDescriptions": [
            "%config.automation.auto%",
            "%config.automation.ask%"
          ],
          "markdownDescription": "%config.automation%"
        },
        "tokenomist.conversation": {
          "type": "string",
          "enum": [
            "same",
            "new"
          ],
          "default": "same",
          "scope": "window",
          "enumDescriptions": [
            "%config.conversation.same%",
            "%config.conversation.new%"
          ],
          "markdownDescription": "%config.conversation%"
        },
        "tokenomist.mode": {
          "type": "string",
          "enum": [
            "saver",
            "balanced",
            "quality",
            "custom"
          ],
          "default": "balanced",
          "scope": "window",
          "enumDescriptions": [
            "%config.mode.saver%",
            "%config.mode.balanced%",
            "%config.mode.quality%",
            "%config.mode.custom%"
          ],
          "markdownDescription": "%config.mode%"
        },
        "tokenomist.thresholds.medium": {
          "type": "number",
          "default": 35,
          "minimum": 1,
          "maximum": 98,
          "scope": "window",
          "markdownDescription": "%config.thresholds.medium%"
        },
        "tokenomist.thresholds.complex": {
          "type": "number",
          "default": 65,
          "minimum": 2,
          "maximum": 99,
          "scope": "window",
          "markdownDescription": "%config.thresholds.complex%"
        },
        "tokenomist.borderlineMargin": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "scope": "window",
          "markdownDescription": "%config.borderlineMargin%"
        },
        "tokenomist.writingModel.followMode": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.writingModel.followMode%"
        },
        "tokenomist.custom.simple": {
          "type": "string",
          "default": "",
          "scope": "window",
          "pattern": "^\\s*([A-Za-z0-9.\\-]+(\\[1[mM]\\])?)?\\s*$",
          "patternErrorMessage": "%config.custom.invalid%",
          "markdownDescription": "%config.custom.simple%"
        },
        "tokenomist.custom.medium": {
          "type": "string",
          "default": "",
          "scope": "window",
          "pattern": "^\\s*([A-Za-z0-9.\\-]+(\\[1[mM]\\])?)?\\s*$",
          "patternErrorMessage": "%config.custom.invalid%",
          "markdownDescription": "%config.custom.medium%"
        },
        "tokenomist.custom.complex": {
          "type": "string",
          "default": "",
          "scope": "window",
          "pattern": "^\\s*([A-Za-z0-9.\\-]+(\\[1[mM]\\])?)?\\s*$",
          "patternErrorMessage": "%config.custom.invalid%",
          "markdownDescription": "%config.custom.complex%"
        },
        "tokenomist.custom.writing": {
          "type": "string",
          "default": "",
          "scope": "window",
          "pattern": "^\\s*([A-Za-z0-9.\\-]+(\\[1[mM]\\])?)?\\s*$",
          "patternErrorMessage": "%config.custom.invalid%",
          "markdownDescription": "%config.custom.writing%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test --test-timeout=30000 \"out/tests/unit/**/*.test.js\" \"out/tests/integration/*.test.js\"",
    "test:integration": "npm run compile && node ./out/tests/integration/runTests.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "vscode:uninstall": "node ./out/src/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "1.94.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
