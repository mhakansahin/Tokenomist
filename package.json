{
  "name": "tokenomist",
  "displayName": "Tokenomist",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "tokenomist",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.specify/feature.json"
  ],
  "contributes": {
    "commands": []
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"out/tests/unit/**/*.test.js\"",
    "test:integration": "npm run compile && node ./out/tests/integration/runTests.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "vscode:uninstall": "node ./out/src/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "1.94.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3"
  }
}
